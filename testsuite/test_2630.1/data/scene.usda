#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

class Xform "SpherePrototype"
{
    def Sphere "geo"
    {
        double radius = 1
    }
}

def Xform "world"
{
    def Mesh "ground"
    {
        float3[] extent = [(-12, 0, -12), (12, 0, 12)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-12, 0, -12), (-12, 0, 12), (12, 0, 12), (12, 0, -12)]
    }

    # The four instances share the same prototype, but are linked to different lights:
    # - sphere_1: white + red, and casts no shadow from the red light
    # - sphere_2: white + blue
    # - sphere_3: white + red
    # - sphere_4: white only
    def Xform "instances"
    {
        def "sphere_1" (
            instanceable = true
            prepend references = </SpherePrototype>
        )
        {
            double3 xformOp:translate = (-4.5, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "sphere_2" (
            instanceable = true
            prepend references = </SpherePrototype>
        )
        {
            double3 xformOp:translate = (-1.5, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "sphere_3" (
            instanceable = true
            prepend references = </SpherePrototype>
        )
        {
            double3 xformOp:translate = (1.5, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "sphere_4" (
            instanceable = true
            prepend references = </SpherePrototype>
        )
        {
            double3 xformOp:translate = (4.5, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "lights"
    {
        # Not linked: lights everything.
        def DistantLight "white"
        {
            float inputs:angle = 1
            color3f inputs:color = (1, 1, 1)
            bool inputs:normalize = 1
            float inputs:intensity = 0.6
            float3 xformOp:rotateXYZ = (-70, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "red" (
            prepend apiSchemas = ["CollectionAPI:lightLink", "CollectionAPI:shadowLink"]
        )
        {
            uniform bool collection:lightLink:includeRoot = 0
            rel collection:lightLink:includes = [
                </world/ground>,
                </world/instances/sphere_1>,
                </world/instances/sphere_3>,
            ]
            rel collection:shadowLink:excludes = </world/instances/sphere_1>
            float inputs:angle = 1
            color3f inputs:color = (1, 0, 0)
            bool inputs:normalize = 1
            float inputs:intensity = 0.6
            float3 xformOp:rotateXYZ = (-45, -40, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "blue" (
            prepend apiSchemas = ["CollectionAPI:lightLink"]
        )
        {
            uniform bool collection:lightLink:includeRoot = 0
            rel collection:lightLink:includes = </world/instances/sphere_2>
            float inputs:angle = 1
            color3f inputs:color = (0, 0, 1)
            bool inputs:normalize = 1
            float inputs:intensity = 1.5
            float3 xformOp:rotateXYZ = (-45, 40, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Camera "camera"
    {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 20.25
        token projection = "perspective"
        float3 xformOp:rotateXYZ = (-18, 0, 0)
        double3 xformOp:translate = (0, 5, 15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
