#usda 1.0
(
    endTimeCode = 1
    startTimeCode = 1
)

def PointInstancer "InvisibleInstancer"
{
    float3[] extent = [(-200, -200, -200), (400, 200, 200)]
    float3[] positions = [(20, -70, 0), (20, 100, 0), (120, -50, 0), (120, 100, 0), (220, -50, 0), (220, 100, 0)]
    int[] protoIndices = [0, 0, 1, 1, 2, 2]
    rel prototypes = [
        </InvisibleInstancer/sphere>,
        </InvisibleInstancer/cone>,
        </InvisibleInstancer/cube>,
    ]
    token visibility = "invisible"

    def Cube "cube"
    {
        custom bool primvars:arnold:smoothing = 0
        double size = 50
    }

    def Sphere "sphere"
    {
        double radius = 40
    }

    def Cone "cone"
    {
        double height = 100
        double radius = 30
    }
}

def PointInstancer "VisibleInstancer"
{
    float3[] extent = [(-400, -200, -200), (200, 200, 200)]
    float3[] positions = [(-220, -70, 0), (-220, 100, 0), (-120, -50, 0), (-120, 100, 0), (-20, -50, 0), (-20, 100, 0)]
    int[] protoIndices = [0, 0, 1, 1, 2, 2]
    rel prototypes = [
        </VisibleInstancer/cube>,
        </VisibleInstancer/sphere>,
        </VisibleInstancer/cone>,
    ]
    token visibility = "inherited"

    def Cube "cube"
    {
        custom bool primvars:arnold:smoothing = 0
        double size = 50
    }

    def Sphere "sphere"
    {
        double radius = 40
    }

    def Cone "cone"
    {
        double height = 100
        double radius = 30
    }
}

