#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    # The asset is referenced under a deeper hierarchy than its own /asset root.
    # A primvars:arnold:shaders string would still point at the old path.
    def Xform "Chars"
    {
        def Xform "hero" (
            prepend references = @./asset.usda@
        )
        {
        }
    }

    def Camera "camera"
    {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 30
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.8, -0.6, 0), (0, 0.6, 0.8, 0), (0, 8, 10, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/camera>
        int2 resolution = (320, 240)
        custom int arnold:global:AA_samples = 3
    }
}
