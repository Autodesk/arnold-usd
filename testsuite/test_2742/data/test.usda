#usda 1.0
(
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Scope "Render"
{
    def RenderSettings "render_settings"
    {
        rel products = [
            </Render/Products/perVar>,
            </Render/Products/legacy>,
            </Render/Products/mixed>,
            </Render/Products/deduced>,
        ]
        int2 resolution = (160, 120)
        custom int arnold:global:AA_samples = 1
    }

    def Scope "Vars"
    {
        # Every RenderVar of the first product authors its own compression, except the last one
        def RenderVar "rgba"
        {
            token dataType = "color4f"
            string sourceName = "RGBA"
            token sourceType = "raw"
            custom string arnold:driver_exr:compression = "dwaa"
        }
        def RenderVar "normal"
        {
            token dataType = "color3f"
            string sourceName = "N"
            token sourceType = "raw"
            custom string arnold:driver_exr:compression = "piz"
        }
        def RenderVar "depth"
        {
            token dataType = "float"
            string sourceName = "Z"
            token sourceType = "raw"
            # no compression authored, so this one falls back to the driver default, "zip"
        }

        # Legacy case: nothing authored on the RenderVars
        def RenderVar "legacyRgba"
        {
            token dataType = "color4f"
            string sourceName = "RGBA"
            token sourceType = "raw"
        }
        def RenderVar "legacyDepth"
        {
            token dataType = "float"
            string sourceName = "Z"
            token sourceType = "raw"
        }

        # RenderProduct-level default, overridden by a single RenderVar
        def RenderVar "mixedRgba"
        {
            token dataType = "color4f"
            string sourceName = "RGBA"
            token sourceType = "raw"
            custom string arnold:driver_exr:compression = "dwab"
        }
        def RenderVar "mixedDepth"
        {
            token dataType = "float"
            string sourceName = "Z"
            token sourceType = "raw"
        }

        # Same as the mixed case, but for a RenderProduct without an arnold:driver
        def RenderVar "deducedRgba"
        {
            token dataType = "color4f"
            string sourceName = "RGBA"
            token sourceType = "raw"
            custom string arnold:driver_exr:compression = "piz"
        }
        def RenderVar "deducedDepth"
        {
            token dataType = "float"
            string sourceName = "Z"
            token sourceType = "raw"
        }
    }

    def Scope "Products"
    {
        def RenderProduct "perVar"
        {
            custom string arnold:driver = "driver_exr"
            rel orderedVars = [</Render/Vars/rgba>, </Render/Vars/normal>, </Render/Vars/depth>]
            token productName = "per_var.exr"
        }
        def RenderProduct "legacy"
        {
            custom string arnold:driver = "driver_exr"
            custom string arnold:driver_exr:compression = "zips"
            rel orderedVars = [</Render/Vars/legacyRgba>, </Render/Vars/legacyDepth>]
            token productName = "legacy.exr"
        }
        def RenderProduct "mixed"
        {
            custom string arnold:driver = "driver_exr"
            custom string arnold:driver_exr:compression = "zips"
            rel orderedVars = [</Render/Vars/mixedRgba>, </Render/Vars/mixedDepth>]
            token productName = "mixed.exr"
        }
        # Without an arnold:driver the driver type is deduced from the filename, and the
        # product-level parameters are named arnold:{parameter}
        def RenderProduct "deduced"
        {
            custom string arnold:compression = "rle"
            rel orderedVars = [</Render/Vars/deducedRgba>, </Render/Vars/deducedDepth>]
            token productName = "deduced.exr"
        }
    }
}
