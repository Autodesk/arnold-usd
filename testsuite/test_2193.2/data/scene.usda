#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# A point instancer of a mesh light (primvars:arnold:light), itself instanced by another point instancer, above a
# grey ground only lit by the mesh light instances. The four instances light the ground, from the transforms of both
# point instancers and the prototype's own transform, which scales it along Z: two elongated pools at the top left
# and two at the bottom right. The prototype light itself doesn't emit, the center of the ground stays black.

def PointInstancer "outer"
{
    point3f[] positions = [(-4, -1, -2), (4, -1, 2)]
    int[] protoIndices = [0, 0]
    rel prototypes = </outer/Prototypes/instancer1>

    def Scope "Prototypes"
    {
        def PointInstancer "instancer1"
        {
            point3f[] positions = [(-2, 0, 0), (2, 0, 0)]
            int[] protoIndices = [0, 0]
            rel prototypes = </outer/Prototypes/instancer1/Prototypes/light_grid>

            def Scope "Prototypes"
            {
                def Mesh "light_grid"
                {
                    bool primvars:arnold:light = 1 (interpolation = "constant")
                    color3f primvars:arnold:light:color = (1, 0, 1) (interpolation = "constant")
                    float primvars:arnold:light:intensity = 3 (interpolation = "constant")
                    bool primvars:arnold:visibility:camera = 0 (interpolation = "constant")
                    int[] faceVertexCounts = [4]
                    int[] faceVertexIndices = [0, 1, 2, 3]
                    # facing down
                    point3f[] points = [(-0.5, 0, -0.5), (0.5, 0, -0.5), (0.5, 0, 0.5), (-0.5, 0, 0.5)]
                    float3[] extent = [(-0.5, 0, -0.5), (0.5, 0, 0.5)]
                    uniform token subdivisionScheme = "none"
                    double3 xformOp:translate = (0, 2, 0)
                    float3 xformOp:scale = (1, 1, 3)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }
        }

    }
}

def Mesh "ground"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 3, 2, 1]
    point3f[] points = [(-10, 0, -5), (10, 0, -5), (10, 0, 5), (-10, 0, 5)]
    float3[] extent = [(-10, 0, -5), (10, 0, 5)]
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)] (interpolation = "constant")
    uniform token subdivisionScheme = "none"
}

def Camera "camera"
{
    float focalLength = 18
    float horizontalAperture = 20.955
    float verticalAperture = 15.2908
    double3 xformOp:translate = (0, 12, 0)
    float xformOp:rotateX = -90
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </camera>
        int2 resolution = (160, 120)
        int arnold:global:AA_samples = 3
    }
}
